/* 作品页 - Light Editorial Theme */
page {
  background: var(--bg-cream);
}

.page-container {
  min-height: 100vh;
  background: var(--bg-cream);
  padding-bottom: 140rpx;
}

.nav-bar {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-white);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid var(--border-subtle);
}

.nav-title {
  font-family: 'Georgia', serif;
  font-size: 34rpx;
  font-weight: 400;
  color: var(--text-dark);
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

.works-section {
  padding: 56rpx 32rpx;
}

.section-label {
  font-size: 22rpx;
  color: var(--accent-amber);
  letter-spacing: 6rpx;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

.section-title {
  font-family: 'Georgia', serif;
  font-size: 52rpx;
  color: var(--text-dark);
  font-weight: 400;
  margin-bottom: 48rpx;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.work-card {
  position: relative;
  background: var(--bg-white);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.work-card.large {
  grid-column: span 2;
}

.work-img {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
  display: block;
}

.work-card.large .work-img {
  height: 420rpx;
}

.work-info {
  padding: 20rpx;
}

.work-title {
  font-family: 'Georgia', serif;
  font-size: 28rpx;
  color: var(--text-dark);
  margin-bottom: 6rpx;
}

.work-author {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 悬浮操作按钮 */
.floating-actions {
  position: fixed;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 200;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.float-action {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--bg-white);
  box-shadow: var(--shadow-soft);
}

.float-icon {
  font-size: 30rpx;
  color: var(--accent-amber);
}

.float-label {
  font-size: 18rpx;
  color: var(--text-muted);
}

/* 底部导航 */
.bottom-tab {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: var(--bg-white);
  box-shadow: 0 -2px 20px rgba(0,0,0,0.04);
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding-top: 16rpx;
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.tab-icon {
  font-size: 42rpx;
  color: var(--text-muted);
}

.tab-text {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
  color: var(--accent-amber);
}