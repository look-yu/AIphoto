<!-- 摄影学院 - Visual Encyclopedia -->
<view class="page-container">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <text class="nav-title">摄影学院</text>
  </view>

  <!-- 页面头部 -->
  <view class="page-header">
    <text class="header-label">Photography Academy</text>
    <text class="header-title">系统学习</text>
    <text class="header-desc">从基础到进阶，逐步掌握摄影技能</text>
  </view>

  <!-- 知识分类列表 -->
  <view class="categories-section">
    <view
      class="category-item {{category.expanded ? 'expanded' : ''}}"
      wx:for="{{categories}}"
      wx:for-item="category"
      wx:key="id"
      data-id="{{category.id}}"
      bindtap="toggleCategory"
    >
      <!-- 分类头部 -->
      <view class="category-header">
        <view class="category-icon">
          <text>{{category.icon}}</text>
        </view>
        <view class="category-info">
          <text class="category-title">{{category.title}}</text>
          <text class="category-desc">{{category.description}}</text>
        </view>
        <view class="category-arrow">
          <text>{{category.expanded ? '−' : '+'}}</text>
        </view>
      </view>

      <!-- 展开的话题列表 -->
      <view class="topics-list" wx:if="{{category.expanded}}">
        <view
          class="topic-item"
          wx:for="{{category.topics}}"
          wx:for-item="topic"
          wx:key="id"
          data-category-id="{{category.id}}"
          data-topic-id="{{topic.id}}"
          data-title="{{topic.title}}"
          bindtap="onTopicTap"
        >
          <view class="topic-dot"></view>
          <view class="topic-content">
            <text class="topic-title">{{topic.title}}</text>
            <text class="topic-summary">{{topic.summary}}</text>
          </view>
          <text class="topic-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮操作按钮 -->
  <view class="floating-actions">
    <view class="float-action">
      <text class="float-icon">♡</text>
      <text class="float-label">关注</text>
    </view>
    <view class="float-action">
      <text class="float-icon">✉</text>
      <text class="float-label">联系</text>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="bottom-tab">
    <view class="tab-item" bindtap="goToIndex">
      <text class="tab-icon">⌂</text>
      <text class="tab-text">主页</text>
    </view>
    <view class="tab-item" bindtap="goToWorks">
      <text class="tab-icon">▦</text>
      <text class="tab-text">作品</text>
    </view>
    <view class="tab-item active">
      <text class="tab-icon">◈</text>
      <text class="tab-text">学院</text>
    </view>
    <view class="tab-item" bindtap="goToAbout">
      <text class="tab-icon">◉</text>
      <text class="tab-text">关于</text>
    </view>
  </view>
</view>