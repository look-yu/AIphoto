/* 摄影学院 - Visual Encyclopedia */
page {
  background: var(--bg-cream);
}

.page-container {
  min-height: 100vh;
  background: var(--bg-cream);
  padding-bottom: 140rpx;
}

/* 顶部导航栏 */
.nav-bar {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-white);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid var(--border-subtle);
}

.nav-title {
  font-family: 'Georgia', serif;
  font-size: 34rpx;
  font-weight: 400;
  color: var(--text-dark);
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

/* 页面头部 */
.page-header {
  padding: 64rpx 48rpx 48rpx;
  background: var(--bg-white);
  margin-bottom: 24rpx;
}

.header-label {
  font-size: 22rpx;
  color: var(--accent-amber);
  letter-spacing: 6rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
  display: block;
}

.header-title {
  font-family: 'Georgia', serif;
  font-size: 56rpx;
  font-weight: 400;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.header-desc {
  font-size: 28rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

/* 分类列表 */
.categories-section {
  padding: 0 32rpx;
}

.category-item {
  background: var(--bg-white);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: all 0.4s ease;
}

.category-item.expanded {
  box-shadow: var(--shadow-soft);
}

/* 分类头部 */
.category-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  gap: 24rpx;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--accent-amber);
  flex-shrink: 0;
}

.category-info {
  flex: 1;
}

.category-title {
  font-family: 'Georgia', serif;
  font-size: 32rpx;
  color: var(--text-dark);
  margin-bottom: 8rpx;
  display: block;
}

.category-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

.category-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--accent-amber);
  font-weight: 300;
}

/* 话题列表 */
.topics-list {
  padding: 0 28rpx 28rpx;
  border-top: 1rpx solid var(--border-subtle);
  margin-top: 0;
}

.topic-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--border-subtle);
}

.topic-item:last-child {
  border-bottom: none;
}

.topic-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent-amber);
  flex-shrink: 0;
}

.topic-content {
  flex: 1;
}

.topic-title {
  font-family: 'Georgia', serif;
  font-size: 28rpx;
  color: var(--text-dark);
  margin-bottom: 4rpx;
  display: block;
}

.topic-summary {
  font-size: 22rpx;
  color: var(--text-muted);
}

.topic-arrow {
  font-size: 28rpx;
  color: var(--accent-amber);
}

/* 悬浮操作按钮 */
.floating-actions {
  position: fixed;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 200;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.float-action {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--bg-white);
  box-shadow: var(--shadow-soft);
}

.float-icon {
  font-size: 30rpx;
  color: var(--accent-amber);
}

.float-label {
  font-size: 18rpx;
  color: var(--text-muted);
}

/* 底部导航 */
.bottom-tab {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: var(--bg-white);
  box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.04);
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding-top: 16rpx;
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.tab-icon {
  font-size: 42rpx;
  color: var(--text-muted);
}

.tab-text {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
  color: var(--accent-amber);
}