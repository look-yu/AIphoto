/* 话题详情页 */
page {
  background: var(--bg-cream);
}

.page-container {
  min-height: 100vh;
  background: var(--bg-cream);
}

/* 顶部导航栏 */
.nav-bar {
  height: 100rpx;
  display: flex;
  align-items: center;
  background: var(--bg-white);
  padding: 0 32rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid var(--border-subtle);
}

.nav-back {
  font-size: 40rpx;
  color: var(--accent-amber);
  margin-right: 24rpx;
}

.nav-title {
  font-family: 'Georgia', serif;
  font-size: 34rpx;
  font-weight: 400;
  color: var(--text-dark);
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

/* 内容区域 */
.content-scroll {
  padding-bottom: 60rpx;
}

/* 头部信息 */
.topic-header {
  display: flex;
  gap: 32rpx;
  padding: 48rpx 40rpx;
  background: var(--bg-white);
  margin-bottom: 24rpx;
}

.topic-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--bg-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--accent-amber);
  flex-shrink: 0;
}

.topic-meta {
  flex: 1;
}

.topic-category {
  font-size: 22rpx;
  color: var(--accent-amber);
  letter-spacing: 4rpx;
  text-transform: uppercase;
  margin-bottom: 12rpx;
  display: block;
}

.topic-title {
  font-family: 'Georgia', serif;
  font-size: 44rpx;
  font-weight: 400;
  color: var(--text-dark);
  margin-bottom: 16rpx;
  display: block;
}

.topic-info {
  display: flex;
  gap: 24rpx;
}

.info-item {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 正文内容 */
.topic-content {
  background: var(--bg-white);
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
}

.content-text {
  font-size: 30rpx;
  color: var(--text-body);
  line-height: 2;
  white-space: pre-line;
}

/* 小贴士 */
.tips-section {
  background: var(--bg-white);
  padding: 40rpx;
}

.tips-title {
  font-family: 'Georgia', serif;
  font-size: 32rpx;
  color: var(--accent-amber);
  margin-bottom: 24rpx;
  display: block;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.tip-bullet {
  color: var(--accent-amber);
  font-size: 28rpx;
  line-height: 1.6;
}

.tip-text {
  font-size: 28rpx;
  color: var(--text-body);
  line-height: 1.6;
  flex: 1;
}

/* 教学示范图片 */
.gallery-section {
  background: var(--bg-white);
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.gallery-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.gallery-title {
  font-family: 'Georgia', serif;
  font-size: 32rpx;
  color: var(--text-dark);
}

.gallery-hint {
  font-size: 22rpx;
  color: var(--text-muted);
}

.gallery-scroll {
  white-space: nowrap;
}

.gallery-grid {
  display: inline-flex;
  gap: 24rpx;
}

.gallery-item {
  width: 320rpx;
  flex-shrink: 0;
}

.gallery-img {
  width: 320rpx;
  height: 220rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.gallery-img:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.gallery-caption {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}