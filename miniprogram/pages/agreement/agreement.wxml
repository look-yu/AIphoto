<!-- 用户协议页 -->
<view class="page-container">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">←</view>
    <text class="nav-title">用户协议</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="content-area">
    <view class="page-header">
      <text class="doc-title">用户协议</text>
      <text class="doc-meta">摄影智评 · 2026年1月版</text>
    </view>

    <view class="toc-bar">
      <text class="toc-label">目录</text>
      <scroll-view class="toc-list" scroll-x>
        <view
          class="toc-item"
          wx:for="{{sections}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="scrollToSection"
        >{{item.title.substring(0, 6)}}</view>
      </scroll-view>
    </view>

    <view class="sections">
      <view
        class="section-block"
        wx:for="{{sections}}"
        wx:key="id"
        id="{{item.id}}"
      >
        <text class="section-title">{{item.title}}</text>
        <text class="section-content">{{item.content}}</text>
      </view>
    </view>
  </view>
</view>
