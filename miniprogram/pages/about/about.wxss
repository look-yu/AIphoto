/* 关于页 - Light Editorial Theme */
page {
  background: var(--bg-cream);
}

.page-container {
  min-height: 100vh;
  background: var(--bg-cream);
  padding-bottom: 140rpx;
}

.nav-bar {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-white);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid var(--border-subtle);
}

.nav-title {
  font-family: 'Georgia', serif;
  font-size: 34rpx;
  font-weight: 400;
  color: var(--text-dark);
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

.about-content {
  padding: 100rpx 48rpx;
}

.about-hero {
  margin-bottom: 64rpx;
}

.about-logo {
  font-family: 'Georgia', serif;
  font-size: 72rpx;
  color: var(--text-dark);
  margin-bottom: 16rpx;
  display: block;
  line-height: 1.1;
}

.about-tagline {
  font-family: 'Georgia', serif;
  font-size: 26rpx;
  font-style: italic;
  color: var(--text-muted);
  letter-spacing: 4rpx;
}

.about-divider {
  width: 80rpx;
  height: 2rpx;
  background: var(--accent-amber);
  margin-bottom: 64rpx;
}

.about-desc-section {
  margin-bottom: 80rpx;
}

.about-desc {
  font-size: 30rpx;
  color: var(--text-body);
  line-height: 1.85;
  display: block;
  margin-bottom: 36rpx;
}

.about-features {
  display: flex;
  flex-direction: column;
  gap: 56rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-left: 8rpx;
  border-left: 2rpx solid var(--border-subtle);
}

.feature-icon {
  font-size: 44rpx;
  color: var(--accent-amber);
  margin-bottom: 8rpx;
}

.feature-title {
  font-family: 'Georgia', serif;
  font-size: 32rpx;
  color: var(--text-dark);
}

.feature-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 悬浮操作按钮 */
.floating-actions {
  position: fixed;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 200;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.float-action {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--bg-white);
  box-shadow: var(--shadow-soft);
}

.float-icon {
  font-size: 30rpx;
  color: var(--accent-amber);
}

.float-label {
  font-size: 18rpx;
  color: var(--text-muted);
}

/* 底部导航 */
.bottom-tab {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: var(--bg-white);
  box-shadow: 0 -2px 20px rgba(0,0,0,0.04);
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding-top: 16rpx;
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.tab-icon {
  font-size: 42rpx;
  color: var(--text-muted);
}

.tab-text {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
  color: var(--accent-amber);
}