/* ================================
   摄影智评小程序 - Light Editorial Theme
   ================================ */

/* ================================
   顶部导航栏
   ================================ */
.nav-bar {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-white);
  position: relative;
  z-index: 100;
}

.nav-title {
  font-family: 'Georgia', serif;
  font-size: 34rpx;
  font-weight: 400;
  color: var(--text-dark);
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

/* ================================
   全屏Banner区域
   ================================ */
.hero-banner {
  position: relative;
  height: 85vh;
  min-height: 1100rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hero-bg image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 柔和光效叠加 */
.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  background:
    linear-gradient(180deg,
      rgba(250,249,247,0.1) 0%,
      rgba(250,249,247,0.3) 40%,
      rgba(250,249,247,0.7) 100%
    );
}

/* 侧边竖向文字 */
.hero-side-text {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%) rotate(90deg);
  transform-origin: center center;
  font-family: 'Georgia', serif;
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 12rpx;
  text-transform: uppercase;
  opacity: 0.6;
  z-index: 3;
}

.hero-content {
  position: absolute;
  bottom: 200rpx;
  left: 0;
  right: 0;
  padding: 0 60rpx;
  z-index: 4;
}

.hero-title {
  font-family: 'Georgia', serif;
  font-size: 68rpx;
  font-weight: 400;
  color: var(--text-dark);
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  line-height: 1.15;
}

.hero-title span {
  color: var(--accent-amber);
}

.hero-subtitle {
  font-family: 'Georgia', serif;
  font-size: 26rpx;
  font-style: italic;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-bottom: 56rpx;
  opacity: 0.9;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 52rpx;
  background: var(--text-dark);
  color: var(--bg-white);
  font-family: 'Georgia', serif;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  transition: all 0.4s ease;
}

.hero-cta:active {
  background: var(--accent-amber);
}

.hero-cta::after {
  content: '→';
  transition: transform 0.3s ease;
}

/* 底部滚动提示 */
.scroll-hint {
  position: absolute;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.scroll-line {
  width: 1rpx;
  height: 50rpx;
  background: linear-gradient(180deg, var(--accent-amber) 0%, transparent 100%);
  animation: scrollPulse 2.5s ease-in-out infinite;
}

.scroll-text {
  font-size: 18rpx;
  color: var(--text-muted);
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

@keyframes scrollPulse {
  0%, 100% { opacity: 0.3; transform: scaleY(0.6); }
  50% { opacity: 0.9; transform: scaleY(1); }
}

/* ================================
   页面容器
   ================================ */
.page-container {
  min-height: 100vh;
  background: var(--bg-cream);
  position: relative;
}

/* ================================
   右侧悬浮操作按钮
   ================================ */
.floating-actions {
  position: fixed;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 200;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.float-action {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.float-action:active {
  transform: scale(0.95);
  background: rgba(201, 164, 96, 0.85);
}

.float-action:active .float-icon {
  color: var(--bg-white);
}

.float-action:active .float-label {
  color: var(--bg-white);
}

.float-icon {
  font-size: 36rpx;
  color: var(--accent-amber);
}

.float-icon.icon-active {
  color: var(--accent-amber);
  display: inline-block;
  transform: scaleX(1.2);
}

.float-label {
  font-size: 16rpx;
  color: var(--accent-amber);
  font-weight: 500;
}

/* 信封图标 */
.envelope-icon {
  position: relative;
  width: 36rpx;
  height: 26rpx;
}

.env-rect {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 36rpx;
  height: 18rpx;
  border: 2rpx solid var(--accent-amber);
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.env-flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 12rpx solid var(--accent-amber);
}

/* ================================
   底部导航栏
   ================================ */
.bottom-tab {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: var(--bg-white);
  box-shadow: 0 -2px 20px rgba(0,0,0,0.04);
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding-top: 16rpx;
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.tab-icon {
  font-size: 42rpx;
  color: var(--text-muted);
  transition: all 0.3s ease;
}

.tab-text {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  transition: all 0.3s ease;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
  color: var(--accent-amber);
}

/* ================================
   作品展示
   ================================ */
.works-section {
  padding: 80rpx 32rpx;
  background: var(--bg-cream);
}

.section-header {
  margin-bottom: 56rpx;
}

.section-label {
  font-size: 22rpx;
  color: var(--accent-amber);
  letter-spacing: 6rpx;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

.section-title {
  font-family: 'Georgia', serif;
  font-size: 52rpx;
  font-weight: 400;
  color: var(--text-dark);
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.work-card {
  position: relative;
  background: var(--bg-white);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.work-card:nth-child(3n+1) {
  grid-column: span 2;
}

.work-img {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
  display: block;
}

.work-card:nth-child(3n+1) .work-img {
  height: 440rpx;
}

.work-overlay {
  padding: 20rpx;
}

.work-title {
  font-family: 'Georgia', serif;
  font-size: 28rpx;
  color: var(--text-dark);
  margin-bottom: 6rpx;
}

.work-meta {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ================================
   联系弹窗
   ================================ */
.contact-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 500;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.contact-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.contact-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
}

.contact-title {
  text-align: center;
  font-family: 'Georgia', serif;
  font-size: 32rpx;
  color: var(--text-dark);
  margin-bottom: 40rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-subtle);
}

.contact-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.contact-label {
  font-size: 26rpx;
  color: var(--text-body);
}

.contact-value {
  font-size: 24rpx;
  color: var(--text-muted);
}

.contact-cancel {
  text-align: center;
  padding: 24rpx;
  margin-top: 20rpx;
  font-size: 30rpx;
  color: var(--text-muted);
}

/* 电话图标 */
.phone-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.phone-body {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid var(--accent-amber);
  border-radius: 50%;
}

.phone-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  background: var(--accent-amber);
  border-radius: 50%;
}

/* 微信图标 */
.wechat-icon {
  position: relative;
  width: 36rpx;
  height: 26rpx;
}

.wechat-rect {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 36rpx;
  height: 18rpx;
  border: 2rpx solid var(--accent-amber);
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.wechat-flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 12rpx solid var(--accent-amber);
}